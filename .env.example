# ==============================================================================
# NIRNAY Environment Variables Template (Public / Example)
# Do not commit real credentials or keys to source control.
# ==============================================================================

# Supabase Public Configuration (Exposed to Vite client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Only Keys (Used in Edge Functions / Backend services; NEVER in Vite client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-share

# Optional External Provider Mock / Sandbox Mode
VITE_PROVIDER_MODE=sandbox_mock

